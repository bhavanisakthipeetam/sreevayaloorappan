{
  "redirects": [
    { "source": "/", "destination": "/en/", "permanent": false },
    { "source": "/favicon.ico", "destination": "/images/logo.png", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
