{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "baseUrl": "src",
    "strictNullChecks": true,
    "types": ["astro/client"],
    "paths": {
      "@components/*": ["components/*"],
      "@layouts/*":    ["layouts/*"],
      "@assets/*":     ["assets/*"],
      "@i18n/*":       ["i18n/*"]
    }
  }
}
