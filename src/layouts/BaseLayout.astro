---
import Navbar from "@components/Navbar.astro";
import Footer from "@components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Sree Vayaloorappan Kiratha Sastha Kshetram — A sacred temple in Vayaloor, Kerala, open on Pooram Nakshatra every month.",
} = Astro.props;
---

<!doctype html>
<html lang={Astro.currentLocale ?? "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="apple-touch-icon"      href="/images/apple-touch-icon.png" />

    <!-- Open Graph / Social share -->
    <meta property="og:type"        content="website" />
    <meta property="og:title"       content={`${title} | Sree Vayaloorappan Kshetram`} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content="/images/og-image.jpg" />
    <meta name="twitter:card"       content="summary_large_image" />
    <meta name="twitter:image"      content="/images/og-image.jpg" />

    <title>{title} | Sree Vayaloorappan Kshetram</title>
  </head>
  <body>
    <Navbar />
    <main style="padding-top: 28px;">
      <slot />
    </main>
    <Footer />

    <!-- Scroll reveal -->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const reveals = document.querySelectorAll(".reveal");
        if (!reveals.length) return;
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("visible");
                obs.unobserve(e.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
        );
        reveals.forEach((el) => obs.observe(el));
      });
    </script>
  </body>
</html>
